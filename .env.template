# ─────────────────────────────────────────
#  NYC Taxi Distributed Lab — .env.template
#  Copia a .env y ajusta según tu entorno
# ─────────────────────────────────────────

# ── Spark ─────────────────────────────────
# Imagen: apache/spark (oficial ASF) — bitnami retiró sus tags versionados en sep 2025
SPARK_VERSION=3.5.1
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ── MLflow ────────────────────────────────
MLFLOW_VERSION=v2.11.3
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Jupyter ───────────────────────────────
JUPYTER_TOKEN=spark123

# ── MariaDB / Hive ────────────────────────
MARIADB_VERSION=10.11
HIVE_VERSION=4.0.0
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=hive_metastore
MYSQL_USER=hive
MYSQL_PASSWORD=hivepass

# ── GCP (opcional — comentar si no se usa BigQuery) ──
# GCP_KEY_LOCAL=./secrets/gcp-key.json
# GCP_KEY_CONTAINER=/opt/spark/secrets/gcp-key.json

# ── Streamlit (nombres modelos en MLflow Registry) ───
MODEL_NAME_FARE=xgb_fare
MODEL_NAME_DURATION=xgb_duration
